PORT=8080
ENV=development

DATABASE_URL=

# Al menos 32 bytes (openssl rand -hex 32)
JWT_SECRET=

# Orígenes permitidos para CORS (separados por coma; obligatorio salvo con ENV=development o ENV=test)
CORS_ORIGINS=

# AES-256-GCM key — 32 hex-encoded bytes (64 hex chars)
ENCRYPTION_KEY=

# HMAC de los contadores antifraude (ADR 0002): obligatoria en todos los entornos,
# 64 hex (openssl rand -hex 32), DISTINTA de ENCRYPTION_KEY y de JWT_SECRET.
ANTIFRAUD_HMAC_KEY=
# Solo durante una rotación (clave anterior, solo lectura); vacía el resto del tiempo.
ANTIFRAUD_HMAC_KEY_PREVIOUS=

# CIDRs de proxies de confianza; vacío = se ignora X-Forwarded-For
TRUSTED_PROXIES=

# Opcional: trace, debug, info, warn, error
LOG_LEVEL=

# SMTP_HOST, SMTP_PORT (> 0) y SMTP_FROM son obligatorios salvo con ENV=development o ENV=test
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# URL pública del frontend para los enlaces de los correos, sin barra final (si la tiene, se quita).
# Obligatoria salvo con ENV=development o ENV=test (ahí cae a http://localhost:3000).
FRONTEND_BASE_URL=

# Servicio de IA (contrato E6-01). IA_PROVEEDOR vacío = IA deshabilitada (503 ia_no_disponible;
# el resto de la app funciona). `doble` solo con ENV=development/test/preprod: con production
# no arranca. IA_API_KEY es un secreto: solo en el gestor de secretos del entorno.
IA_PROVEEDOR=
IA_API_KEY=
IA_MODELO=
