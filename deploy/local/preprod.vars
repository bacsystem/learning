# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  NOT FOR PRODUCTION — valores FALSOS de la preproducción local (qa).      ║
# ║  Se versionan a propósito: solo protegen datos 100 % sintéticos.          ║
# ║  Ningún valor de este archivo puede usarse en Railway ni en otra nube:    ║
# ║  lo comprueba docs/ops/checklist-release.md §5.                           ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# Lo lee docker compose con --env-file (make local/up); no es un .env.

PREPROD_PG_USER=capacitate
PREPROD_PG_PASSWORD=NOT-FOR-PRODUCTION-preprod-pg-password
PREPROD_PG_DB=capacitate_preprod

# ≥ 32 bytes (config.Load).
PREPROD_JWT_SECRET=NOT-FOR-PRODUCTION-preprod-jwt-secret-do-not-reuse
# 64 hex: el formato no admite texto. Generada con openssl rand -hex 32 solo
# para preproducción; distinta de cualquier clave real.
PREPROD_ENCRYPTION_KEY=0f4ecda5a31ef1fc85b2fdf474b3c75c47cdbeb003578b4b4fb3a05f1c1e414f

# Contraseñas de los usuarios sintéticos de cmd/seed/demo (12-72 caracteres).
# demo_admin usa la primera; demo_enfermeria, demo_medicina, demo_pendiente y
# demo_esp_inactiva, la segunda (ver deploy/local/README.md).
PREPROD_DEMO_ADMIN_PASSWORD=NOT-FOR-PRODUCTION-demo-admin
PREPROD_DEMO_POSTULANTE_PASSWORD=NOT-FOR-PRODUCTION-demo-user
