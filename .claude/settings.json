{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "auto",
  "permissions": {
    "allow": [
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(./assets/**)",
      "Bash(cat *.env*)",
      "Bash(grep * *.env*)",
      "Bash(go test -exec:*)",
      "Bash(go test * -exec:*)",
      "Bash(go vet -vettool:*)",
      "Bash(go vet * -vettool:*)",
      "Bash(git diff --output:*)",
      "Bash(git diff * --output:*)",
      "Bash(git diff --ext-diff:*)",
      "Bash(git diff * --ext-diff:*)",
      "Bash(git log --output:*)",
      "Bash(git log * --output:*)",
      "Bash(git log --ext-diff:*)",
      "Bash(git log * --ext-diff:*)"
    ]
  }
}
