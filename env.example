# Variables para docker-compose.yml (entorno local).
# Crea el .env con secretos generados:  make compose/init
# o cópialo a mano y completa los obligatorios:  cp env.example .env

# ── Obligatorios ──────────────────────────────────────────────────────────────
# Genera cada uno con: openssl rand -hex 32
JWT_SECRET=
# AES-256-GCM: exactamente 64 caracteres hex (32 bytes).
# Si vas a cargar personas cifradas existentes, usa la MISMA clave con la que se cifraron.
ENCRYPTION_KEY=
# HMAC de los contadores antifraude (ADR 0002): 64 caracteres hex, DISTINTA de
# ENCRYPTION_KEY y de JWT_SECRET. make compose/init la genera.
ANTIFRAUD_HMAC_KEY=
# Solo durante una rotación (clave anterior, solo lectura); vacía el resto del tiempo.
ANTIFRAUD_HMAC_KEY_PREVIOUS=

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=learning
# Obligatorio, sin valor por defecto (make compose/init genera uno: openssl rand -hex 24).
# Solo se aplica al CREAR el volumen pgdata: para cambiarlo después,
# make compose/reset (borra los datos) o ALTER USER ... PASSWORD dentro de psql.
# Usa solo caracteres seguros en URL (p.ej. hex): va dentro de DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=learning

# ── Puertos expuestos en el host (solo en 127.0.0.1, ver docker-compose.yml) ──
# 5433 para no chocar con un Postgres local en 5432
DB_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ── Backend ───────────────────────────────────────────────────────────────────
ENV=development
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
TRUSTED_PROXIES=
# Opcional: trace, debug, info, warn, error. Vacío = debug con ENV=development, info en el resto.
LOG_LEVEL=
# Espera máxima por el advisory lock de migraciones al arrancar (duración de Go).
MIGRATE_LOCK_TIMEOUT=10m

# SMTP (opcional; sin esto no se envían correos)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Servicio de IA (contrato E6-01) ───────────────────────────────────────────
# IA_PROVEEDOR vacío = IA deshabilitada (503 ia_no_disponible; el resto de la app
# funciona). `doble` solo con ENV=development/test/preprod: con production no
# arranca. IA_API_KEY es un secreto: solo en el gestor de secretos del entorno.
IA_PROVEEDOR=
IA_API_KEY=
IA_MODELO=

# ── Frontend (se incrustan al construir la imagen) ────────────────────────────
# URL del backend tal como la ve el NAVEGADOR (no http://backend:8080).
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_STORAGE_PREFIX=
# Correo público de contacto (privacidad, términos, landing). Vacío: se usa el de src/config.ts.
NEXT_PUBLIC_CONTACT_EMAIL=contact@bacsystemsolutions.com
